{
  "name": "gymbulag",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "DB_DRIVER=mysql vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "server": "node --env-file-if-exists=.env server/index.mjs",
    "server:local": "DB_DRIVER=mysql node --env-file-if-exists=.env server/index.mjs",
    "db:migrate": "node --env-file-if-exists=.env server/migrate.mjs",
    "db:status": "node --env-file-if-exists=.env server/migrate.mjs status",
    "db:migrate:local": "DB_DRIVER=mysql node --env-file-if-exists=.env server/migrate.mjs",
    "db:status:local": "DB_DRIVER=mysql node --env-file-if-exists=.env server/migrate.mjs status",
    "start": "npm run build && npm run server",
    "db:copy-mysql": "node --env-file-if-exists=.env scripts/mysql-to-supabase.mjs"
  },
  "dependencies": {
    "@types/three": "^0.187.0",
    "date-fns": "^3.6.0",
    "dexie": "^4.0.8",
    "dexie-react-hooks": "^1.1.7",
    "lucide-react": "^0.441.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.12.7",
    "three": "^0.187.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^6.0.0",
    "mysql2": "^3.24.6",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.2",
    "workbox-window": "^7.1.0"
  }
}
