# Copy to .env and fill in.

# Postgres connection string. On Supabase: Project → Connect → "Transaction pooler" URI (port 6543).
# Use the same value for local dev, `npm run db:migrate`, and the Vercel project's environment.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# DATABASE_SSL=false   # only for a local Postgres without TLS

# Optional: people need this code to create an account. Set it for a public deploy,
# otherwise anyone can sign up.
SIGNUP_CODE=

# Optional: "Continue with Google / Facebook" on the login screen. Leave empty to hide a button.
# Register https://your-app/ (and http://localhost:5173/) as the redirect URI with each provider. See README.
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Where people send privacy / data-deletion requests. Shown on /privacy and /data-deletion
# (the URLs you give Google and Facebook). Needed at build time, so set it in Vercel too.
CONTACT_EMAIL=

# Comma-separated emails of accounts that get the admin panel (/admin): manage users,
# create gym communities + QR codes, and give gym owners access to their community.
ADMIN_EMAILS=

# Optional: the address printed in community QR codes. Defaults to wherever the admin
# panel is opened, so set it when you make QR codes from localhost.
# VITE_PUBLIC_URL=https://your-app.vercel.app

# Settings → "Your data" (backup / restore / wipe). Hidden unless set to true.
# SHOW_USER_DATA=true

# Local `npm run server` port
PORT=8787

# Local MySQL, used by `npm run dev:local`, `db:migrate:local` and `db:copy-mysql`
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gymbulag
# DB_SOCKET=/var/run/mysqld/mysqld.sock
